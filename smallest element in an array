the smallest elements in an array.

class Main {
    public static void main(String[] args) {
        int[] numbers = {15, 42, 7, 89, 23, 11};
        
        // Start by assuming the first number is the smallest
        int min = numbers[0];
        
        for (int i = 1; i < numbers.length; i++) {
            // Check if the current number is smaller than our current min
            if (numbers[i] < min) {
                min = numbers[i];
            }
        }
        
        System.out.println("Smallest Element: " + min);
    }
}
